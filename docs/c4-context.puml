@startuml C4_Context_SIPRO
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Diagrama de Contexto — SIPRO (Sistema de Provas)

Person(professor, "Professor / Coordenador", "Cria provas, gera PDFs e acessa relatórios de desempenho.")
Person(aluno, "Aluno", "Realiza a prova impressa com gabarito de respostas.")

System(sipro, "SIPRO", "Plataforma web para criação, aplicação e correção automatizada de provas educacionais da SEDUC-GO.")

System_Ext(seduc_email, "Sistema de E-mail SEDUC-GO", "Envia notificações e credenciais de acesso aos usuários.")
System_Ext(impressora, "Impressora / Sistema de Impressão", "Recebe o PDF gerado para impressão física das provas.")

Rel(professor, sipro, "Acessa via navegador web", "HTTPS")
Rel(sipro, professor, "Exibe interface, relatórios e PDFs")
Rel(sipro, seduc_email, "Envia e-mails de notificação", "SMTP")
Rel(sipro, impressora, "Disponibiliza PDF para impressão", "Download")
Rel(aluno, sipro, "Gabarito lido pela câmera do sistema", "Físico / Câmera")

@enduml
